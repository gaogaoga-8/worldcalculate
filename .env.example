# Node 24. Set these in your host environment; never put credentials in Git.
HOST=127.0.0.1
PORT=5175
# Public HTTPS deployment: set its exact origin and use secure cookies.
# APP_ORIGIN=https://your-domain.example
# COOKIE_SECURE=1
# COMMUNITY_DB=/persistent-volume/community.sqlite
# Configure a chat/completions-compatible model for all visitors.
# ORACLE_BASE_URL=https://your-model-provider.example/v1
# ORACLE_MODEL=your-model-name
# ORACLE_API_KEY=
# Optional local development alternative:
# CURSOR_API_KEY=
